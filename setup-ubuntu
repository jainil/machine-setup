#!/usr/bin/env bash

# One-file Ubuntu VM setup. Safe to run more than once.
set -euo pipefail

usage() {
  echo "Usage: $0 [--skip-system-packages]" >&2
}

skip_system_packages=false
case "${1:-}" in
  "") ;;
  --skip-system-packages) skip_system_packages=true ;;
  *) usage; exit 2 ;;
esac
[[ $# -le 1 ]] || { usage; exit 2; }

[[ -r /etc/os-release ]] || { echo "Cannot identify this operating system." >&2; exit 1; }
# shellcheck disable=SC1091
source /etc/os-release
if [[ "${ID:-}" != "ubuntu" && "${ID_LIKE:-}" != *ubuntu* ]]; then
  echo "This setup is for Ubuntu only." >&2
  exit 1
fi

[[ $EUID -ne 0 ]] || {
  echo "Run this setup as the login user, not root." >&2
  exit 1
}

log() { printf '\n==> %s\n' "$*"; }

if [[ $skip_system_packages == false ]]; then
  log "Installing Ubuntu prerequisites"
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential curl file git procps
fi

if [[ ! -d "${OSH:-$HOME/.oh-my-bash}" ]]; then
  log "Installing Oh My Bash"
  bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/ohmybash/oh-my-bash/master/tools/install.sh)" \
    --unattended
else
  log "Oh My Bash is already installed"
fi

if ! command -v brew >/dev/null 2>&1 && [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

if ! command -v brew >/dev/null 2>&1; then
  log "Installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

brew_bin="$(command -v brew)"
shellenv_line="eval \"\$(${brew_bin} shellenv)\""
for profile in "$HOME/.profile" "$HOME/.bashrc"; do
  touch "$profile"
  grep -qF "$shellenv_line" "$profile" || printf '\n%s\n' "$shellenv_line" >> "$profile"
done

log "Installing CLI tools"
brew bundle --file=/dev/stdin <<'BREWFILE'
brew "bat"
brew "eza"
brew "fd"
brew "ffmpeg"
brew "fnm"
brew "fzf"
brew "gh"
brew "imagemagick"
brew "libmagic"
brew "librsvg"
brew "mkcert"
brew "nss"
brew "pipx"
brew "ripgrep"
brew "rtk"
brew "uv"
brew "wget"
brew "zoxide"

BREWFILE

log "Configuring fzf shell integration"
fzf_init_line='eval "$(fzf --bash)"'
grep -qF "$fzf_init_line" "$HOME/.bashrc" || printf '\n%s\n' "$fzf_init_line" >> "$HOME/.bashrc"

log "Configuring Node.js 24 and pnpm"
fnm_env_line='eval "$(fnm env --use-on-cd --shell bash)"'
grep -qF "$fnm_env_line" "$HOME/.bashrc" || printf '\n%s\n' "$fnm_env_line" >> "$HOME/.bashrc"

eval "$(fnm env --use-on-cd --shell bash)"
fnm install 24
fnm default 24
fnm use 24
npm install --global corepack@latest
corepack enable pnpm
pnpm --version

log "Setup complete"
echo "Start a new Bash shell to load Oh My Bash and Homebrew into your environment."
